# Server port (default 4321)
PORT=4321

# Admin credentials, used the FIRST time the server runs to create the admin
# account. Change the password afterwards from the admin dashboard, or delete
# server/data/auth.json and restart with new values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Secret used to sign session cookies. If unset, a random secret is generated
# and persisted to server/data/secret.key on first run.
SESSION_SECRET=

# Set to "1" when running behind an HTTPS reverse proxy so session cookies are
# marked Secure.
TRUST_PROXY=
